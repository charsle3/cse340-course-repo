<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% users.forEach(user => { %>
            <li>
                <p>
                    Name: <%= user.name %> <br>
                    Email: <%= user.email %> <br>
                    Role: <%= user.role_name %> <br>
                    Access: <%= user.role_description %>
                </p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>